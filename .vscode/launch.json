{
  // Startkonfigurationen für den Debug-Reiter (Play-Symbol mit Käfer, links).
  // Auswählen und F5 drücken — VS Code nimmt automatisch die venv.
  // Stand: 22.08.2026
  "version": "0.2.0",
  "configurations": [
    {
      // Ungefährlich, deshalb zuerst: rechnet nur, lädt nichts, ändert nichts.
      // Erwartet: 37 passed in rund 4 Sekunden.
      "name": "Tests (alle 37)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "MPLBACKEND": "Agg" },
      "justMyCode": false
    },
    {
      // ⚠ ACHTUNG: Überschreibt output/ — genau daraus stammen die Abbildungen
      // und Zahlen der Seminararbeit. Vorher sichern:
      //   cp -r output output_backup
      // Laufzeit rund 77 Minuten (98 % davon RF-Hyperparametersuche, einkernig
      // wegen deterministic=true). Kein Internet nötig, solange
      // data/prices.pkl existiert — yfinance muss aber installiert sein.
      "name": "Backtest komplett (⚠ ÜBERSCHREIBT output/)",
      "type": "debugpy",
      "request": "launch",
      "module": "portfolio",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Schneller Probelauf über config.schnell.json: Hyperparametersuche nur
      // alle 6 Monate, Dashboard nur alle 5 Schritte. Schreibt nach
      // output_probelauf/, lässt output/ also in Ruhe. Die Ergebnisse weichen
      // von denen der Arbeit ab — nur zum Ausprobieren.
      "name": "Backtest schnell (→ output_probelauf/)",
      "type": "debugpy",
      "request": "launch",
      "module": "portfolio",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PORTFOLIO_CONFIG": "${workspaceFolder}/config.schnell.json" },
      "justMyCode": true
    },
    {
      // Rechnet den Signifikanzblock aus output/daily_returns.csv nach.
      // Sekunden statt 77 Minuten. Schreibt keine Datei.
      // ⚠ Kontrollrechnung auf gerundeten Daten — maßgeblich bleibt
      // output/experiment_log.json.
      "name": "Signifikanz nachrechnen",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/signifikanz.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Sharpe Ratio über Transaktionskosten von 0 bis 100 Basispunkten.
      // Erzeugt output/13_kosten_sensitivitaet.png und die zugehörige CSV.
      "name": "Kostensensitivität (Abb. 13)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/kosten_sensitivitaet.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Kontrollrechnung zu § 3.1/§ 3.2 der Arbeit, rund 10 Sekunden.
      // Für die langen Zusatzschritte in args "--sweep" (~7 min) oder
      // "--baumkorrelation" (~55 min) ergänzen.
      "name": "Kontrollrechnung Kapitel 3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/nachrechnen_kapitel3.py",
      "args": [],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Die gerade offene Datei ausführen — praktisch beim Herumprobieren und
      // für die übrigen Zusatzskripte (z. B. nachrechnen_kapitel2.py).
      "name": "Aktuelle Datei ausführen",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
