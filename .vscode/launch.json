{
  // Startkonfigurationen für den Debug-Reiter (Play-Symbol mit Käfer, links).
  // Auswählen und F5 drücken — VS Code nimmt automatisch die venv.
  "version": "0.2.0",
  "configurations": [
    {
      // Ungefährlich, deshalb zuerst: rechnet nur, lädt nichts, ändert nichts.
      // Erwartet: 37 passed in rund 4 Sekunden.
      "name": "Tests (alle 37)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests/", "-q"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "MPLBACKEND": "Agg" },
      "justMyCode": false
    },
    {
      // ⚠ ACHTUNG: Überschreibt output/ — genau daraus stammen die Abbildungen
      // und Zahlen der Seminararbeit. Vorher sichern:
      //   cp -r output output_backup
      // Laufzeit rund 77 Minuten (98 % davon RF-Hyperparametersuche, einkernig
      // wegen deterministic=true). Kein Internet nötig, solange
      // data/prices.pkl existiert — yfinance muss aber installiert sein.
      "name": "Backtest komplett (⚠ ÜBERSCHREIBT output/)",
      "type": "debugpy",
      "request": "launch",
      "module": "portfolio",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Schneller Probelauf über config.schnell.json: Hyperparametersuche nur
      // alle 6 Monate, Dashboard nur alle 5 Schritte. Schreibt nach
      // output_probelauf/, lässt output/ also in Ruhe. Die Ergebnisse weichen
      // von denen der Arbeit ab — nur zum Ausprobieren.
      "name": "Backtest schnell (→ output_probelauf/)",
      "type": "debugpy",
      "request": "launch",
      "module": "portfolio",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PORTFOLIO_CONFIG": "${workspaceFolder}/config.schnell.json" },
      "justMyCode": true
    },
    {
      // Rechnet ALLE eigenen Zahlen der Arbeit nach (Kapitel 2–7, Anhang) und
      // vergleicht sie mit dem Wortlaut. Rund eine Minute, schreibt keine Datei.
      "name": "Alle Zahlen der Arbeit prüfen",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/skripte/alle_kapitel.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Erzeugt Abbildung 5 der Arbeit (output/13_kosten_sensitivitaet.png)
      // und die zugehörige CSV neu.
      "name": "Abbildung 5: Kostensensitivität",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/skripte/abbildung_kostensensitivitaet.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Kapitel 3 einschließlich der Baumkorrelation (rund 55 Minuten).
      "name": "Kapitel 3 vollständig (lang)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/skripte/kapitel_3_random_forest.py",
      "args": ["--baumkorrelation"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    },
    {
      // Die gerade offene Datei ausführen — praktisch beim Herumprobieren und
      // für einzelne Kapitel (z. B. skripte/kapitel_6_ergebnisse.py).
      "name": "Aktuelle Datei ausführen",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true
    }
  ]
}
